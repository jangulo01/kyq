# Copiar a infra/.env y rellenar. Generar secretos con: openssl rand -hex 32
# IP o nombre por el que los móviles llegan a esta máquina (LiveKit la anuncia a los clientes).
KYQ_PUBLIC_HOST=192.168.1.66

POSTGRES_PASSWORD=
KYQ_JWT_SECRET=
KYQ_CENTRIFUGO_API_KEY=
KYQ_CENTRIFUGO_TOKEN_SECRET=
KYQ_CENTRIFUGO_ADMIN_PASSWORD=
KYQ_CENTRIFUGO_ADMIN_SECRET=

# Desarrollo: con valor, el OTP no envía SMS y acepta este código. Vacío en producción.
KYQ_DEV_OTP_CODE=123456
KYQ_SEED_ADMIN_PHONE=+573000000000

# Errores a Sentry (opcional). Vacío: no se envía nada.
KYQ_SENTRY_DSN=

# Fotos de documentos KYC en MinIO (002). Generar: openssl rand -hex 16 (mínimo 8 caracteres
# para el usuario y 8 para la clave). KYQ_S3_PUBLIC_ENDPOINT es la URL con la que el móvil llega
# a MinIO (por defecto http://KYQ_PUBLIC_HOST:9000). En producción: Cloudflare R2.
KYQ_S3_ACCESS_KEY=
KYQ_S3_SECRET_KEY=
KYQ_S3_BUCKET=kyq-kyc
# KYQ_S3_PUBLIC_ENDPOINT=http://192.168.1.66:9000

# Bold (pasarela de pago, 002). KYQ_BOLD_ENV: vacío (desactivado) | sandbox | production.
# Llaves en el panel de Bold → Integraciones → Llaves de API (de pruebas en sandbox). Nunca versionarlas.
KYQ_BOLD_ENV=
KYQ_BOLD_IDENTITY_KEY=
KYQ_BOLD_SECRET_KEY=
