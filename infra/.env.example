# Copiar a infra/.env y rellenar. Generar secretos con: openssl rand -hex 32
# IP o nombre por el que los móviles llegan a esta máquina (LiveKit la anuncia a los clientes).
KYQ_PUBLIC_HOST=192.168.1.66

POSTGRES_PASSWORD=
KYQ_JWT_SECRET=
KYQ_CENTRIFUGO_API_KEY=
KYQ_CENTRIFUGO_TOKEN_SECRET=
KYQ_CENTRIFUGO_ADMIN_PASSWORD=
KYQ_CENTRIFUGO_ADMIN_SECRET=

# Desarrollo: con valor, el OTP no envía SMS y acepta este código. Vacío en producción.
KYQ_DEV_OTP_CODE=123456
KYQ_SEED_ADMIN_PHONE=+573000000000

# Errores a Sentry (opcional). Vacío: no se envía nada.
KYQ_SENTRY_DSN=
