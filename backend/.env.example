# Copiar a .env para desarrollo local. Valores de desarrollo; nunca usar en producción.
KYQ_HTTP_ADDR=:8080
KYQ_DATABASE_URL=postgres://kyq:kyq_dev@localhost:5432/kyq?sslmode=disable
KYQ_JWT_SECRET=dev-only-change-me-32-bytes-minimum!!

KYQ_CENTRIFUGO_API_URL=http://localhost:8000/api
KYQ_CENTRIFUGO_API_KEY=dev-only-api-key
KYQ_CENTRIFUGO_TOKEN_SECRET=dev-only-change-me

# Errores a Sentry (opcional; vacío no envía nada). Se filtran teléfonos, OTP y tokens.
# KYQ_SENTRY_DSN=
# KYQ_SENTRY_ENVIRONMENT=dev
KYQ_LIVEKIT_URL=ws://localhost:7880
# Opcional: URL HTTP interna de LiveKit si difiere de KYQ_LIVEKIT_URL.
# KYQ_LIVEKIT_API_URL=http://livekit:7880
KYQ_LIVEKIT_API_KEY=devkey
KYQ_LIVEKIT_API_SECRET=secret

KYQ_OSRM_URL=http://localhost:5000
KYQ_CITY_CODE=bogota

# OTP: si KYQ_DEV_OTP_CODE tiene valor se usa el emisor de desarrollo y no se envían SMS.
KYQ_DEV_OTP_CODE=123456
KYQ_TWILIO_ACCOUNT_SID=
KYQ_TWILIO_AUTH_TOKEN=
KYQ_TWILIO_VERIFY_SERVICE_SID=

# Semilla
KYQ_SEED_ADMIN_PHONE=+573000000000

# Fotos de documentos (002): S3 compatible (MinIO en desarrollo, R2 en producción).
# KYQ_S3_ENDPOINT es el que usa la API; KYQ_S3_PUBLIC_ENDPOINT el que va en las URLs firmadas
# (por defecto el mismo). Región por defecto us-east-1 (R2: auto).
KYQ_S3_ENDPOINT=http://localhost:9000
# KYQ_S3_PUBLIC_ENDPOINT=http://192.168.1.66:9000
KYQ_S3_ACCESS_KEY=kyq-dev-minio
KYQ_S3_SECRET_KEY=dev-only-change-me
KYQ_S3_BUCKET=kyq-kyc
# KYQ_S3_REGION=us-east-1

# Bold (002). KYQ_BOLD_ENV: vacío (pagos desactivados) | sandbox | production. Con valor, las
# dos llaves son obligatorias. En sandbox la firma del webhook usa clave vacía (así lo hace Bold).
KYQ_BOLD_ENV=
KYQ_BOLD_IDENTITY_KEY=
KYQ_BOLD_SECRET_KEY=
# KYQ_BOLD_API_URL=https://integrations.api.bold.co

# Avisos por SMS (002). Con KYQ_DEV_OTP_CODE los SMS solo se registran en el log. En producción,
# remitente de Twilio Messaging (número o Messaging Service SID MG...).
# KYQ_TWILIO_SMS_FROM=
