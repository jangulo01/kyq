# Copiar a .env para desarrollo local. Valores de desarrollo; nunca usar en producción.
KYQ_HTTP_ADDR=:8080
KYQ_DATABASE_URL=postgres://kyq:kyq_dev@localhost:5432/kyq?sslmode=disable
KYQ_JWT_SECRET=dev-only-change-me-32-bytes-minimum!!

KYQ_CENTRIFUGO_API_URL=http://localhost:8000/api
KYQ_CENTRIFUGO_API_KEY=dev-only-api-key
KYQ_CENTRIFUGO_TOKEN_SECRET=dev-only-change-me

KYQ_LIVEKIT_URL=ws://localhost:7880
KYQ_LIVEKIT_API_KEY=devkey
KYQ_LIVEKIT_API_SECRET=secret

KYQ_OSRM_URL=http://localhost:5000
KYQ_CITY_CODE=bogota

# OTP: si KYQ_DEV_OTP_CODE tiene valor se usa el emisor de desarrollo y no se envían SMS.
KYQ_DEV_OTP_CODE=123456
KYQ_TWILIO_ACCOUNT_SID=
KYQ_TWILIO_AUTH_TOKEN=
KYQ_TWILIO_VERIFY_SERVICE_SID=

# Semilla
KYQ_SEED_ADMIN_PHONE=+573000000000
